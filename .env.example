APP_NAME="RDU Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://rdu-dashboard.test

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# APPLICATION DATABASE (Read-Write)
# rdu_dashboard — สำหรับ users, sessions, audit_logs, settings
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rdu_dashboard
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_CHARSET=utf8

# ============================================================
# HOSxP READ-ONLY DATABASE (SELECT ONLY)
# ⚠️  ห้ามใช้ Connection นี้สำหรับ INSERT/UPDATE/DELETE
# ⚠️  ต้องใช้ DB::connection('rdu') เท่านั้น
# ============================================================
RDU_DB_HOST=127.0.0.1
RDU_DB_PORT=5432
RDU_DB_DATABASE=hosxp
RDU_DB_USERNAME=rdu_readonly
RDU_DB_PASSWORD=
RDU_DB_SCHEMA=public
RDU_DB_CHARSET=utf8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rdu@chiangklang-hospital.go.th"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Usernames (HOSxP officer_login_name) allowed to open /admin/settings/* — comma separated
SETTINGS_ADMIN_USERNAMES=nuttapong
